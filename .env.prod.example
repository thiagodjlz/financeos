# Modelo do .env de um ambiente de producao (VM externa). Copie para .env no servidor
# e preencha TODOS os campos — a stack se recusa a subir com qualquer um em branco.
#
#   cp .env.prod.example .env
#
# Este arquivo nunca deve ser commitado preenchido: .env ja esta no .gitignore.

# --- Banco ---------------------------------------------------------------
POSTGRES_DB=financeos
POSTGRES_USER=financeos
# Gere um valor proprio: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Portas internas -----------------------------------------------------
# Em producao nenhuma delas e publicada no host (o docker-compose.prod.yml
# remove os mapeamentos); quem escuta na internet e so o Caddy, em 80/443.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- Endereco publico e HTTPS --------------------------------------------
# Como a stack fica acessivel na internet. Dois modos:
#
#   acme    (padrao) dominio proprio + Let's Encrypt emitido pelo Caddy. Exige IP
#           publico (nao funciona atras de CGNAT) e as portas 80 e 443 abertas ate
#           esta maquina, que fica com o IP exposto.
#   funnel  Tailscale Funnel: dispensa dominio, IP publico e porta aberta, e nao
#           expoe o IP da maquina. Acrescenta a sobreposicao docker-compose.funnel.yml.
FINANCEOS_EXPOSICAO=acme

# Endereco publico do sistema, sem o https:// na frente.
#   modo acme   -> dominio que aponta (registro A/AAAA) para o IP desta maquina.
#   modo funnel -> nome .ts.net do no, ex.: financeos.tailXXXX.ts.net
#                  (o nome do tailnet esta em https://login.tailscale.com/admin/dns).
FINANCEOS_DOMAIN=

# --- Modo acme -----------------------------------------------------------
# E-mail do cadastro do certificado (avisos de expiracao). Obrigatorio no modo acme;
# no modo funnel quem emite e renova o certificado e a Tailscale, e este campo some.
ACME_EMAIL=

# --- Modo funnel ---------------------------------------------------------
# Nome do no na sua tailnet. Precisa bater com o primeiro rotulo de FINANCEOS_DOMAIN.
TS_HOSTNAME=financeos
# Auth key gerada em https://login.tailscale.com/admin/settings/keys — lida apenas na
# primeira subida: depois a sessao vive no volume financeos_tailscale_state e a chave
# pode sair daqui. Desligue a expiracao da chave do no no admin console, senao o site
# sai do ar sozinho quando ela vencer.
TS_AUTHKEY=

# CORS_ORIGINS e definido pelo docker-compose.prod.yml a partir de FINANCEOS_DOMAIN.

# --- Administrador do sistema --------------------------------------------
# Criado (ou atualizado) a cada subida, com acesso total e independente de perfil.
# Minimo de 12 caracteres. Trocar aqui e reiniciar o backend e a forma de recuperar
# o acesso caso a senha seja perdida.
FINANCEOS_ADMIN_EMAIL=
FINANCEOS_ADMIN_PASSWORD=

# --- Versao --------------------------------------------------------------
# Tag das imagens. O scripts/deploy.sh preenche isto a partir do arquivo VERSION.
APP_VERSION=
