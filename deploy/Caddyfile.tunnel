# Caddyfile do modo funnel (FINANCEOS_EXPOSICAO=funnel).
#
# Aqui o Caddy NAO publica porta no host e NAO emite certificado: quem fala com a
# internet e o container do Tailscale, que termina o TLS e repassa para ca pela rede
# interna do Compose. Por isso o site escuta em `:80` puro — endereco so-porta ja
# desliga o HTTPS automatico do Caddy.
#
# O Caddy continua no caminho pelos headers de seguranca e pelo bloqueio de
# /docs e /openapi. Para o modo com dominio proprio e Let's Encrypt, ver ./Caddyfile.

:80 {
	encode zstd gzip

	# Rede de seguranca: a imagem de producao ja e construida sem Swagger/OpenAPI
	# (ARG SWAGGER_UI=false), mas uma imagem antiga ou reconstruida na mao nao estaria.
	# Os dois ficam na raiz, fora do `quarkus.http.root-path=/api`.
	@docs path /docs /docs/* /openapi /openapi/*
	respond @docs 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy frontend:80
}
